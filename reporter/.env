# Reporter settings. The real SMTP password goes only in the server's copy
# of this file (skip-worktree there); never commit it.
TZ=Africa/Accra
# name shown on the portal and reports until one is set in Settings (blank = "Reports")
REPORT_NAME=
# which reports the scheduler sends, and the local hour it sends them
REPORTS=weekly,monthly,quarterly
SEND_HOUR=7
# Email and the schedule are set in the portal (Settings, Grafana admins only)
# and saved to reporter/out/settings.json. The values below are only the
# starting point before anything is saved there.
# email: leave SMTP_HOST empty to only save PDFs to reporter/out
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# comma-separated recipients
REPORT_TO=
