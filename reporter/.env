# Reporter settings. The real SMTP password goes only in the server's copy
# of this file (skip-worktree there); never commit it.
TZ=Africa/Accra
REPORT_NETWORK_NAME=PXGH network
# which reports the scheduler sends, and the local hour it sends them
REPORTS=weekly,monthly,quarterly
SEND_HOUR=7
# email: leave SMTP_HOST empty to only save PDFs to reporter/out
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# comma-separated recipients
REPORT_TO=
